{
  "serverName": "lark-cli-mcp-wrapper",
  "description": "MCP server wrapping lark-cli for Feishu/Lark integration",
  "protocol": "MCP",
  "containerConfig": {
    "port": 8000,
    "healthCheckPath": "/health",
    "environment": [
      { "name": "MCP_TRANSPORT", "value": "http" },
      { "name": "PORT", "value": "8000" },
      { "name": "NO_COLOR", "value": "1" },
      { "name": "LARKSUITE_CLI_BRAND", "value": "feishu" }
    ],
    "secrets": [
      { "name": "LARKSUITE_CLI_APP_ID", "valueFrom": "${SECRET_ARN}:LARK_APP_ID::" },
      { "name": "LARKSUITE_CLI_APP_SECRET", "valueFrom": "${SECRET_ARN}:LARK_APP_SECRET::" }
    ]
  },
  "gateway": {
    "enabled": true,
    "authType": "IAM"
  }
}
